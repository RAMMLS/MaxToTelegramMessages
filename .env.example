# MAX web session. Never commit real values.
MAX_VIEWER_ID=
MAX_AUTH_TOKEN=
# Recommended when importing an existing web session.
MAX_DEVICE_ID=
# Alternative to the two variables above: path to a local ignored JSON file.
# MAX_SESSION_FILE=.max-session.json

MAX_WS_URL=wss://api.oneme.ru/websocket
# Keep false in normal operation. A custom endpoint receives the MAX session token.
MAX_ALLOW_CUSTOM_WS_URL=false
MAX_APP_VERSION=26.8.8
MAX_LOCALE=ru

# Required allowlist. Empty means that nothing is forwarded.
# Up to 1000 signed int64 IDs. Separate values with commas, for example:
# MAX_CHAT_IDS=123456789,-987654321
MAX_CHAT_IDS=

# Set to true to print observed chat IDs without calling Telegram.
MAX_DISCOVERY_MODE=false

TELEGRAM_BOT_TOKEN=
# Non-zero numeric chat ID returned by --discover-telegram-chats.
TELEGRAM_CHAT_ID=

# 1..10000
BRIDGE_QUEUE_SIZE=100
BRIDGE_STATE_DB=.max-to-telegram.sqlite3
# 1..3600
MAX_RECONNECT_MAX_SECONDS=10
# 0..20
TELEGRAM_MAX_RETRIES=5
LOG_LEVEL=INFO
