# alwaysdata deployment template. Never commit real values.
MAX_VIEWER_ID=
MAX_AUTH_TOKEN=
MAX_DEVICE_ID=
MAX_SESSION_FILE=data/max-session.json

MAX_WS_URL=wss://api.oneme.ru/websocket
MAX_ALLOW_CUSTOM_WS_URL=false
MAX_APP_VERSION=26.8.8
MAX_LOCALE=ru

# Exact signed-int64 allowlist. Empty remains fail-closed.
MAX_CHAT_IDS=
MAX_DISCOVERY_MODE=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_REPORT_ENABLED=false

BRIDGE_QUEUE_SIZE=100
BRIDGE_STATE_DB=data/state.sqlite3
MAX_RECONNECT_MAX_SECONDS=10
TELEGRAM_MAX_RETRIES=5
LOG_LEVEL=INFO
